{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@dtd/chain-sdk/*": ["../chain/sdk/*"],
      "@dtd/shared/*": ["../shared/*"],
      "@dtd/identity/*": ["../identity/*"]
    }
  },
  "include": [
    "api/**/*.ts",
    "tests/**/*.ts",
    "../identity/auth/**/*.ts",
    "../identity/rbac/**/*.ts",
    "../identity/companies/**/*.ts",
    "../identity/subscriptions/**/*.ts",
    "../shared/**/*.ts",
    "../chain/sdk/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "../identity/tests/**",
    "../custody/**",
    "../gps/**"
  ]
}